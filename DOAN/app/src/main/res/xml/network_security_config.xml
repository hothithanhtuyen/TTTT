<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/vnpay_cert_0" />
            <certificates src="@raw/vnpay_cert_1" />
            <certificates src="@raw/vnpay_cert_2" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">sandbox.vnpayment.vn</domain>
        <domain includeSubdomains="true">vnpayment.vn</domain>
        <domain includeSubdomains="true">trycloudflare.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/vnpay_cert_0" />
            <certificates src="@raw/vnpay_cert_1" />
            <certificates src="@raw/vnpay_cert_2" />
        </trust-anchors>
    </domain-config>
</network-security-config>
