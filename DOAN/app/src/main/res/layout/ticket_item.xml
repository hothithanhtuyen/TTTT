<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#1A1D28"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Poster Thumbnail -->
        <androidx.cardview.widget.CardView
            android:layout_width="70dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ticketPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Poster"
                android:scaleType="centerCrop"
                android:src="@drawable/your_background_image" />
        </androidx.cardview.widget.CardView>

        <!-- Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ticketTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tên phim"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ticketrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rạp: CGV Thanh Khê"
                android:textColor="#A0A5BA"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ticketDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20/10/2026"
                    android:textColor="#C0C5DA"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text="•"
                    android:textColor="#64B5F6"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ticketlich"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19:30"
                    android:textColor="#FF5252"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/ticketghe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Ghế: E05, E06"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Side: Status Badge & QR Action -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ticketStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1B5E20"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="Đã xác nhận"
                android:textColor="#A5D6A7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnViewQR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#2E344A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="Mã QR 🎟"
                android:textColor="#64B5F6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
