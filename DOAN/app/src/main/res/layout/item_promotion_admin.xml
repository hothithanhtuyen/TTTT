<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:elevation="4dp">

    <!-- Tiêu đề khuyến mãi -->
    <TextView
        android:id="@+id/txtPromotionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tiêu đề khuyến mãi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="4dp"/>

    <!-- Thời gian khuyến mãi -->
    <TextView
        android:id="@+id/txtPromotionDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thời gian khuyến mãi"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"/>

    <!-- Địa điểm -->
    <TextView
        android:id="@+id/txtPromotionLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Địa điểm"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/txtPromotionImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ảnh"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:paddingBottom="8dp"
        android:visibility="gone"/>

    <!-- 2 Nút Chỉnh Sửa & Xóa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnEditPromotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sửa"
            android:backgroundTint="@android:color/holo_blue_dark"
            android:textColor="@android:color/white"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDeletePromotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xóa"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@android:color/white"/>
    </LinearLayout>

</LinearLayout>
